+#include <rex/filesystem.h>
+#include <SDL3/SDL.h>
+#include <jni.h>
+#include <string>
+namespace rex::filesystem {
+int OpenAndroidContentFileDescriptor(const std::string_view uri, const char* mode) {
+  auto* env = static_cast<JNIEnv*>(SDL_GetAndroidJNIEnv());
+  if (!env || env->PushLocalFrame(8) < 0) return -1;
+  auto activity = static_cast<jobject>(SDL_GetAndroidActivity());
+  int fd = -1;
+  if (activity) {
+    auto cls = env->GetObjectClass(activity);
+    auto method = env->GetMethodID(cls, "openContentFileDescriptor", "(Ljava/lang/String;Ljava/lang/String;)I");
+    if (method) {
+      auto java_uri = env->NewStringUTF(std::string(uri).c_str());
+      auto java_mode = env->NewStringUTF(mode);
+      fd = env->CallIntMethod(activity, method, java_uri, java_mode);
+    }
+  }
+  if (env->ExceptionCheck()) { env->ExceptionClear(); fd = -1; }
+  env->PopLocalFrame(nullptr);
+  return fd;
+}
