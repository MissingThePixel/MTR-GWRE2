 namespace rex::graphics::vulkan {
 
 namespace {
+
+// Diagnostic CPU wall times; disabled during normal warning-only launches.
+enum class VulkanCpuPhase { Draw, Copy, Swap, Replay, Submit, Textures, Targets, Primitives, Bindings, Ranges, Pipeline, Count };
+class VulkanCpuTimingScope {
+ public:
+  explicit VulkanCpuTimingScope(VulkanCpuPhase phase)
+      : phase_(phase), enabled_(REXCVAR_GET(gpu_command_stats)),
+        start_(enabled_ ? Clock::now() : Clock::time_point{}) {}
+  ~VulkanCpuTimingScope() {
+    if (!enabled_) return;
+    struct Window {
+      Clock::time_point start = Clock::now();
+      std::array<double, size_t(VulkanCpuPhase::Count)> times{};
+      std::array<uint64_t, size_t(VulkanCpuPhase::Count)> counts{};
+    };
+    static thread_local Window window;
+    const auto now = Clock::now();
+    window.times[size_t(phase_)] += std::chrono::duration<double, std::milli>(now - start_).count();
+    ++window.counts[size_t(phase_)];
+    if (phase_ == VulkanCpuPhase::Swap && now - window.start >= std::chrono::seconds(5)) {
+      REXGPU_INFO("Vulkan CPU spans: draws={} draw={:.1f} ms, copies={} copy={:.1f} ms, swaps={} swap={:.1f} ms, replay={:.1f} ms, submit={:.1f} ms",
+                  window.counts[0], window.times[0], window.counts[1], window.times[1],
+                  window.counts[2], window.times[2], window.times[3], window.times[4]);
+      REXGPU_INFO("Vulkan draw stages: textures={:.1f} ms, targets={:.1f} ms, primitives={:.1f} ms",
+                  window.times[5], window.times[6], window.times[7]);
+      REXGPU_INFO("Vulkan draw remainder: bindings={:.1f} ms, ranges={:.1f} ms, pipeline={:.1f} ms",
+                  window.times[8], window.times[9], window.times[10]);
+      window = Window{};
+    }
+  }
+ private:
+  using Clock = std::chrono::steady_clock;
+  VulkanCpuPhase phase_;
+  bool enabled_;
+  Clock::time_point start_;
+};
+
+template <typename F>
+decltype(auto) MeasureVulkanCpu(VulkanCpuPhase phase, F&& call) {
+  VulkanCpuTimingScope timing(phase);
+  return call();
+}
 
