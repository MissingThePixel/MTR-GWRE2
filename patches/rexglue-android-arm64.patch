+bool PhysicalHeap::HandleTrackedWriteFault(
+    rex::thread::global_unique_lock_type lock, uint32_t virtual_address) {
+  if (virtual_address < heap_base_ || virtual_address - heap_base_ >= heap_size_) {
+    return false;
+  }
+  const uint32_t system_page =
+      (virtual_address - heap_base_ + host_address_offset()) / system_page_size_;
+  if (system_page >= system_page_count_) return false;
+  if (IsHostPageWriteWatched(system_page)) {
+    return TriggerCallbacks(std::move(lock), virtual_address, 1, true, false);
+  }
+  // Another thread may already have cleared the same write watch. Check every
+  // guest page sharing the host page before restoring write access; a genuine
+  // read-only, decommitted or unreserved page must use the original fault path.
+  const uint32_t first =
+      rex::sat_sub(system_page * system_page_size_, host_address_offset()) >> page_size_shift_;
+  const uint32_t last =
+      rex::sat_sub((system_page + 1) * system_page_size_ - 1, host_address_offset()) >> page_size_shift_;
+  if (last >= page_table_.size()) return false;
+  std::lock_guard<std::recursive_mutex> heap_lock(heap_mutex_);
+  for (uint32_t page = first; page <= last; ++page) {
+    const auto& entry = page_table_[page];
+    if (!(entry.state & memory::kMemoryAllocationCommit) ||
+        ToPageAccess(entry.current_protect) != rex::memory::PageAccess::kReadWrite) {
+      return false;
+    }
+  }
+  return rex::memory::Protect(membase_ + heap_base_ + system_page * system_page_size_,
+                              system_page_size_, rex::memory::PageAccess::kReadWrite);
+}
