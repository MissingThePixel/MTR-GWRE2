+  if (found->second.empty()) {
+    reusable_texture_resources_.erase(found);
+  }
+  reusable_texture_resource_bytes_ -= pooled.size;
+  resource_out = std::move(pooled.resource);
+  allocation_out = std::move(pooled.allocation);
+  state_out = pooled.state;
+  ++reusable_texture_resource_hits_;
+  return true;
