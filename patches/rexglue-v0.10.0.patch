+void XmpApp::AdvanceIfEnded() {
+#ifdef _WIN32
+  ApplyMusicGain();
+  if (state_ != State::kPlaying || !active_playlist_ || active_playlist_->songs.empty()) return;
+  bool failed = false;
+  bool ended = false;
+  int queued_bytes = -1;
+  std::chrono::nanoseconds played_duration{0};
+  std::chrono::nanoseconds decoded_duration{0};
+  {
+    std::lock_guard lock(music_playback_->mutex);
+    failed = music_playback_->failed;
+    if (!failed && (music_playback_->loading || !music_playback_->stream)) return;
+    if (!failed) {
+      queued_bytes = SDL_GetAudioStreamQueued(music_playback_->stream);
+      decoded_duration = music_playback_->decoded_duration;
+      played_duration = std::chrono::steady_clock::now() - music_playback_->started_at -
+                        music_playback_->paused_duration;
+      // The SDL input queue can still report data after the audible end. Use
+      // decoded PCM duration as a fallback, accounting for XMPPause.
+      ended = decoded_duration.count() > 0 &&
+              (played_duration >= decoded_duration + std::chrono::milliseconds(250) ||
+               (queued_bytes == 0 &&
+                played_duration + std::chrono::milliseconds(100) >= decoded_duration));
+      if (!ended) return;
+    }
+  }
+  if (failed) {
+    state_ = State::kIdle;
+    OnStateChanged();
+    return;
+  }
+  REXKRNL_INFO("XMP: song ended, queued={} played={} ms duration={} ms", queued_bytes,
+               std::chrono::duration_cast<std::chrono::milliseconds>(played_duration).count(),
+               std::chrono::duration_cast<std::chrono::milliseconds>(decoded_duration).count());
+  StopMusic();
+  active_song_index_ = (active_song_index_ + 1) % active_playlist_->songs.size();
+  if (!StartActiveSong()) state_ = State::kIdle;
+  OnSongChanged();
+#endif
+}
 
