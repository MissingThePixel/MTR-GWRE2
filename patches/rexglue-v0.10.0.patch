+
+bool DecodeMusic(const std::filesystem::path& path, DecodedMusic& output,
+                 const std::atomic<uint64_t>* generation = nullptr,
+                 uint64_t expected_generation = 0) {
+  const HRESULT com_result = CoInitializeEx(nullptr, COINIT_MULTITHREADED);
+  const bool release_com = SUCCEEDED(com_result);
+  if (FAILED(com_result) && com_result != RPC_E_CHANGED_MODE) {
+    return false;
+  }
+  const HRESULT startup_result = MFStartup(MF_VERSION);
+  if (FAILED(startup_result)) {
+    if (release_com) CoUninitialize();
+    return false;
+  }
+
+  bool success = false;
+  do {
+    Microsoft::WRL::ComPtr<IMFSourceReader> reader;
+    if (FAILED(MFCreateSourceReaderFromURL(path.c_str(), nullptr, &reader))) break;
+    if (FAILED(reader->SetStreamSelection(MF_SOURCE_READER_ALL_STREAMS, FALSE))) break;
+    if (FAILED(reader->SetStreamSelection(MF_SOURCE_READER_FIRST_AUDIO_STREAM, TRUE))) break;
+
+    Microsoft::WRL::ComPtr<IMFMediaType> requested_type;
+    if (FAILED(MFCreateMediaType(&requested_type))) break;
+    if (FAILED(requested_type->SetGUID(MF_MT_MAJOR_TYPE, MFMediaType_Audio))) break;
+    if (FAILED(requested_type->SetGUID(MF_MT_SUBTYPE, MFAudioFormat_Float))) break;
+    if (FAILED(reader->SetCurrentMediaType(MF_SOURCE_READER_FIRST_AUDIO_STREAM, nullptr,
+                                           requested_type.Get()))) break;
+
+    Microsoft::WRL::ComPtr<IMFMediaType> actual_type;
+    if (FAILED(reader->GetCurrentMediaType(MF_SOURCE_READER_FIRST_AUDIO_STREAM,
+                                            &actual_type))) break;
+    UINT32 sample_rate = 0;
+    UINT32 channels = 0;
+    if (FAILED(actual_type->GetUINT32(MF_MT_AUDIO_SAMPLES_PER_SECOND, &sample_rate)) ||
+        FAILED(actual_type->GetUINT32(MF_MT_AUDIO_NUM_CHANNELS, &channels)) ||
+        sample_rate == 0 || channels == 0 || channels > 8) break;
+    output.sample_rate = static_cast<int>(sample_rate);
+    output.channels = static_cast<int>(channels);
+
+    for (;;) {
+      if (generation && generation->load() != expected_generation) break;
+      DWORD flags = 0;
+      Microsoft::WRL::ComPtr<IMFSample> sample;
+      if (FAILED(reader->ReadSample(MF_SOURCE_READER_FIRST_AUDIO_STREAM, 0, nullptr,
+                                    &flags, nullptr, &sample))) break;
+      if (sample) {
+        Microsoft::WRL::ComPtr<IMFMediaBuffer> buffer;
+        if (FAILED(sample->ConvertToContiguousBuffer(&buffer))) break;
+        BYTE* bytes = nullptr;
+        DWORD length = 0;
+        if (FAILED(buffer->Lock(&bytes, nullptr, &length))) break;
+        if (output.pcm.size() + length > static_cast<size_t>(std::numeric_limits<int>::max())) {
+          buffer->Unlock();
+          break;
+        }
+        output.pcm.insert(output.pcm.end(), bytes, bytes + length);
+        buffer->Unlock();
+      }
+      if (flags & MF_SOURCE_READERF_ENDOFSTREAM) {
+        success = !output.pcm.empty();
+        break;
+      }
+    }
+  } while (false);
+
+  MFShutdown();
