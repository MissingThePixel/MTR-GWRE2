+// PGR4 registers every track with literal "Title" / "Artist" placeholders.
+// Its WMA files have no title or artist tags, but all 115 filenames use
+// Artist-Title.wma. The XMP info buffer has 40-byte UTF-16 fields.
+std::u16string ReadableMusicPart(std::u16string_view part) {
+  std::u16string result;
+  result.reserve(part.size() + 4);
+  for (size_t i = 0; i < part.size(); ++i) {
+    const char16_t current = part[i];
+    const char16_t previous = i ? part[i - 1] : 0;
+    const bool before_uppercase = current >= u'A' && current <= u'Z' &&
+                                  ((previous >= u'a' && previous <= u'z') ||
+                                   (previous >= u'0' && previous <= u'9'));
+    const bool before_digit = current >= u'0' && current <= u'9' &&
+                              ((previous >= u'a' && previous <= u'z') ||
+                               (previous >= u'A' && previous <= u'Z'));
+    if (before_uppercase || before_digit) result += u' ';
+    result += current == u'_' ? u' ' : current;
+  }
+  // Prefer a full compact name over losing the final word to the field limit.
+  if (result.size() > 19 && part.size() <= 19) return std::u16string(part);
+  if (result.size() > 19) result.resize(19);
+  return result;
+}
+
+void RestoreMusicMetadataFromFilename(std::u16string_view path, std::u16string& title,
+                                      std::u16string& artist) {
+  if (title != u"Title" && artist != u"Artist" && !title.empty() && !artist.empty()) return;
+  const size_t slash = path.find_last_of(u"\\/");
+  const size_t start = slash == std::u16string_view::npos ? 0 : slash + 1;
+  const size_t dash = path.find(u'-', start);
+  if (dash == std::u16string_view::npos) return;
+  const size_t dot = path.find_last_of(u'.');
+  const size_t end = dot == std::u16string_view::npos || dot < dash ? path.size() : dot;
+  if (dash == start || end <= dash + 1) return;
+  if (artist == u"Artist" || artist.empty()) {
+    artist = ReadableMusicPart(path.substr(start, dash - start));
+  }
+  if (title == u"Title" || title.empty()) {
+    title = ReadableMusicPart(path.substr(dash + 1, end - dash - 1));
+  }
+}
