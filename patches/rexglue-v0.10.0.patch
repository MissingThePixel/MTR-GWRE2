+  const uint64_t pool_limit_bytes =
+      uint64_t(std::clamp(REXCVAR_GET(texture_reuse_pool_limit_mib), 16, 1024)) << 20;
+  if (size <= pool_limit_bytes && REXCVAR_GET(texture_reuse_pool_replace_oldest)) {
+    while (reusable_texture_resource_bytes_ > pool_limit_bytes - size) {
+      if (!EvictOldestReusableEntry(reusable_texture_resources_,
+                                    reusable_texture_resource_bytes_)) break;
+      ++reusable_texture_resource_replaced_;
+    }
+  }
+  if (size > pool_limit_bytes || reusable_texture_resource_bytes_ > pool_limit_bytes - size) {
