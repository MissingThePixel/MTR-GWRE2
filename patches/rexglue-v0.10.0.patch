+  if (++range_stats.requests >= range_stats.report_at) {
+    REXGPU_INFO("Shared memory range sample: requests={}, empty={}, ready={}, uploads={}, pages={}",
+                range_stats.requests, range_stats.empty, range_stats.ready, range_stats.uploads,
+                range_stats.pages);
